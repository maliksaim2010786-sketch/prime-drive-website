{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/.*", "dest": "/server.js" },
    { "src": "/.*", "dest": "/server.js" }
  ],
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,admin.html,styles.css,script.js,assets/**,data/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
