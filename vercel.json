{
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/.*", "dest": "/server.js" },
    { "src": "/styles\\.css", "dest": "/server.js" },
    { "src": "/script\\.js", "dest": "/server.js" },
    { "src": "/admin\\.html", "dest": "/server.js" },
    { "src": "/assets/.*", "dest": "/server.js" },
    { "src": "/.*", "dest": "/server.js" }
  ],
  "functions": {
    "server.js": {
      "includeFiles": "**/*"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
